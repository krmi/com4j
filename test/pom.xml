<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.cerpsw.external.com4j</groupId>
    <artifactId>com4j-parent</artifactId>
    <version>20260611</version>
  </parent>

  <artifactId>com4j-test</artifactId>

  <name>com4j Tests</name>

  <properties>
    <!-- Set to true to skip tests (default: true, requires com4j.dll registered via regsvr32) -->
    <com4j.test.skip>true</com4j.test.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.cerpsw.external.com4j</groupId>
      <artifactId>com4j</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>de.cerpsw.external.com4j</groupId>
        <artifactId>maven-com4j-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>gen</goal>
            </goals>
            <configuration>
              <skip>${com4j.test.skip}</skip>
              <libId>AEDD2B06-81EF-499d-A9D6-E32B3188B61A</libId>
              <package>com4j_idl</package>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <skip>${com4j.test.skip}</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
